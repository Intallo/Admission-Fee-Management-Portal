# Copy to .env.local for local app configuration.
# Never commit .env, .env.local, production credentials, or service-role secrets.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Server-side only. Do not prefix with NEXT_PUBLIC_ and never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=SET_ONLY_IN_TRUSTED_SERVER_ENVIRONMENT

# Local PostgreSQL is created by Supabase CLI; do not paste production DB passwords here.
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
